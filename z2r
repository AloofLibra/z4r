#!/bin/sh

# Основной путь обновления zator - tar-релизы GitHub (zator-{core,webui,full}.tar.gz,
# собирает webui-src/scripts/pack-zator-tar.mjs). Развёртывание делегируется
# /opt/zator/z2r_lib/deploy.sh, когда он уже на устройстве; на свежей установке
# работает встроенный минимальный путь с теми же защитами файлов.
# Пофайловый raw-путь остаётся резервом: -raw-update, недоступность релизов.
# Флаги: -no-update, -raw-update, update, check, --variant=core|webui|full,
#        --version=<релиз> (пин), --tar <файл>.

# Z2R_INSTALL_DIR/Z2R_BIN_PATH/Z2R_RELEASES_URL — оверрайды для тестов песочницы
INSTALL_DIR="${Z2R_INSTALL_DIR:-/opt}"
Z2R_CONF="${INSTALL_DIR}/z2r.conf"
DEFAULT_BRANCH="zator"
DEFAULT_RAW_URL="https://raw.githubusercontent.com/AloofLibra/zator/${DEFAULT_BRANCH}"
RAW_URL="$DEFAULT_RAW_URL"
API_BASE_URL=""
MIRROR_URL=""
DEFAULT_INSTALLER_URL="https://raw.githubusercontent.com/AloofLibra/z4r/z2r/z2r"
DEFAULT_INSTALLER_MIRROR_URL="https://git.px.rkn.quest/z2r/plain/z2r?h=z2r"
INSTALLER_URL="$DEFAULT_INSTALLER_URL"
INSTALLER_MIRROR_URL="$DEFAULT_INSTALLER_MIRROR_URL"
LIB_FILES_FALLBACK="ui.sh provider.sh telemetry.sh recommendations.sh netcheck.sh premium.sh strategies.sh submenus.sh actions.sh config.sh orchestra_state.sh"
LIB_FILES_REQUIRED="config.sh orchestra_state.sh"
MAX_DOWNLOAD_JOBS=3
SHA_CACHE_DIR="${INSTALL_DIR}/zator/.z2r_sha_cache"
ZATOR_ROOT="${INSTALL_DIR}/zator"
DEPLOY_VERSION_FILE="$ZATOR_ROOT/extra_strats/cache/deploy/version.env"
RELEASES_BASE="https://github.com/AloofLibra/zator/releases/download"
RELEASES_URL_OVERRIDE="${Z2R_RELEASES_URL:-}"
LATEST_JSON="/tmp/z2r_latest_$$.json"
AUTOUPDATE="on"
DEPLOY_VARIANT=""
ZAPRET2_MARGIN_KB=8192
DEPLOY_SLACK_KB=1024
# Дополнительные аргументы curl для raw.githubusercontent.com.
# Заполняется только после проверки IP через DoH; TLS-проверку не отключаем.
RAW_DL_EXTRA_ARGS=""

load_conf() {
    [ -f "$Z2R_CONF" ] || return 1
    conf_raw=$(sed -n 's/^RAW_URL=//p' "$Z2R_CONF" 2>/dev/null | tr -d '\r' | tail -n 1)
    case "$conf_raw" in
        http://*|https://*)
            case "$conf_raw" in
                *[[:space:]]*|"") ;;
                *) RAW_URL="$conf_raw" ;;
            esac
            ;;
    esac
    conf_installer=$(sed -n 's/^INSTALLER_URL=//p' "$Z2R_CONF" 2>/dev/null | tr -d '\r' | tail -n 1)
    case "$conf_installer" in
        http://*|https://*)
            case "$conf_installer" in
                *[[:space:]]*|"") ;;
                *) INSTALLER_URL="$conf_installer"; INSTALLER_MIRROR_URL="" ;;
            esac
            ;;
    esac
    conf_autoupdate=$(sed -n 's/^AUTOUPDATE=//p' "$Z2R_CONF" 2>/dev/null | tr -d '\r' | tail -n 1)
    case "$conf_autoupdate" in
        on|off) AUTOUPDATE="$conf_autoupdate" ;;
    esac
    conf_variant=$(sed -n 's/^DEPLOY_VARIANT=//p' "$Z2R_CONF" 2>/dev/null | tr -d '\r' | tail -n 1)
    case "$conf_variant" in
        core|webui|full) DEPLOY_VARIANT="$conf_variant" ;;
    esac
}

save_conf() {
    mkdir -p "$INSTALL_DIR" 2>/dev/null
    conf_tmp="${Z2R_CONF}.tmp.$$"
    if printf 'RAW_URL=%s\nBRANCH=%s\nINSTALLER_URL=%s\nAUTOUPDATE=%s\nDEPLOY_VARIANT=%s\n' "$RAW_URL" "$BRANCH" "$INSTALLER_URL" "$AUTOUPDATE" "$DEPLOY_VARIANT" > "$conf_tmp" 2>/dev/null; then
        mv -f "$conf_tmp" "$Z2R_CONF" || rm -f "$conf_tmp"
    else
        rm -f "$conf_tmp"
        echo "⚠ Не удалось записать $Z2R_CONF"
    fi
}

derive_repo_endpoints() {
    case "$RAW_URL" in
        https://raw.githubusercontent.com/*/*/*)
            repo_owner=$(printf '%s' "$RAW_URL" | cut -d/ -f4)
            repo_name=$(printf '%s' "$RAW_URL" | cut -d/ -f5)
            API_BASE_URL="https://api.github.com/repos/${repo_owner}/${repo_name}/contents"
            MIRROR_URL="https://git.px.rkn.quest/${repo_owner}/plain"
            RELEASES_BASE="https://github.com/${repo_owner}/${repo_name}/releases/download"
            [ -n "$RELEASES_URL_OVERRIDE" ] && RELEASES_BASE="$RELEASES_URL_OVERRIDE"
            # Конвенция форков: загрузчик лежит в репо <owner>/z2r (ветка z2r).
            if [ "$RAW_URL" != "$DEFAULT_RAW_URL" ] && [ "$INSTALLER_URL" = "$DEFAULT_INSTALLER_URL" ]; then
                INSTALLER_URL="https://raw.githubusercontent.com/${repo_owner}/z2r/z2r/z2r"
                INSTALLER_MIRROR_URL=""
            fi
            ;;
        *)
            API_BASE_URL=""
            MIRROR_URL=""
            ;;
    esac
}

load_conf

# Флаги развёртывания разбираем до первого позиционного аргумента (URL/default).
NO_UPDATE=0
RAW_UPDATE=0
CMD_UPDATE=0
CMD_CHECK=0
DEPLOY_VARIANT_ARG=""
DEPLOY_VERSION_ARG=""
LOCAL_TAR=""
while [ $# -gt 0 ]; do
    case "$1" in
        -no-update) NO_UPDATE=1; shift ;;
        -raw-update) RAW_UPDATE=1; shift ;;
        update) CMD_UPDATE=1; shift ;;
        check) CMD_CHECK=1; shift ;;
        --variant=core|--variant=webui|--variant=full) DEPLOY_VARIANT_ARG="${1#--variant=}"; shift ;;
        --version=*) DEPLOY_VERSION_ARG="${1#--version=}"; shift ;;
        --tar)
            [ $# -ge 2 ] || { echo "Ошибка: --tar требует путь к файлу"; exit 1; }
            LOCAL_TAR="$2"
            shift 2
            ;;
        -*) echo "⚠ Неизвестный флаг: $1 (игнорируется)"; shift ;;
        *) break ;;
    esac
done

URL_ARGS_GIVEN=0
case "${1:-}" in
    default)
        RAW_URL="$DEFAULT_RAW_URL"
        INSTALLER_URL="$DEFAULT_INSTALLER_URL"
        INSTALLER_MIRROR_URL="$DEFAULT_INSTALLER_MIRROR_URL"
        if [ -f "$Z2R_CONF" ]; then
            rm -f "$Z2R_CONF" && echo "✓ $Z2R_CONF удалён, используются значения по умолчанию"
        else
            echo "Значения по умолчанию (файл $Z2R_CONF не найден)"
        fi
        shift
        ;;
    http://*|https://*)
        RAW_URL="$1"
        URL_ARGS_GIVEN=1
        shift
        case "${1:-}" in
            "") ;;
            http://*|https://*)
                INSTALLER_URL="$1"
                INSTALLER_MIRROR_URL=""
                shift
                ;;
            *)
                echo "Ошибка: ветка указывается в URL, а не отдельным аргументом"
                echo "Пример: z2r https://raw.githubusercontent.com/<владелец>/<репо>/<ветка> [URL загрузчика]"
                exit 1
                ;;
        esac
        ;;
esac

RAW_URL=$(printf '%s' "$RAW_URL" | sed 's#/\+$##')
case "$RAW_URL" in
    ""|*[[:space:]]*)
        echo "Ошибка: некорректный URL"
        exit 1
        ;;
esac
case "$RAW_URL" in
    https://raw.githubusercontent.com/*/*)
        case "$RAW_URL" in
            https://raw.githubusercontent.com/*/*/*) ;;
            *)
                echo "Ошибка: в URL не указана ветка: $RAW_URL"
                echo "Пример: z2r https://raw.githubusercontent.com/<владелец>/<репо>/<ветка> [URL загрузчика]"
                [ "$URL_ARGS_GIVEN" -eq 1 ] || echo "URL взят из $Z2R_CONF, сброс: z2r default"
                exit 1
                ;;
        esac
        ;;
esac
BRANCH=$(printf '%s' "$RAW_URL" | awk -F/ '{print $NF}')

derive_repo_endpoints
if [ "$URL_ARGS_GIVEN" -eq 1 ]; then
    echo "Репозиторий: $RAW_URL (ветка: $BRANCH)"
    echo "Загрузчик: $INSTALLER_URL"
fi
[ "$RAW_URL" = "$DEFAULT_RAW_URL" ] || echo "Кастомный репозиторий: $RAW_URL (ветка: $BRANCH), загрузчик: $INSTALLER_URL"

# Определение пути для команды z2r
BIN_PATH="${Z2R_BIN_PATH:-}"
if [ -z "$BIN_PATH" ]; then
    if [ -d /opt/bin ]; then
        BIN_PATH="/opt/bin/z2r"
    elif [ -d /usr/local/bin ] && [ -w /usr/local/bin ]; then
        BIN_PATH="/usr/local/bin/z2r"
    elif [ -d /usr/bin ] && [ -w /usr/bin ]; then
        BIN_PATH="/usr/bin/z2r"
    else
        echo "Ошибка: не найдено подходящее место для установки"
        exit 1
    fi
fi

# Проверка прав root для стандартных систем
[ "$(id -u 2>/dev/null)" != "0" ] && [ ! -d /opt/bin ] && [ ! -d /jffs/scripts ] && {
    echo "Возможно скрипт запущен без прав root (sudo)"
}

# Проверка wget или curl
if which curl >/dev/null 2>&1; then
    DL_CMD="curl -sS -L -o"
    DL_TIMEOUT="--max-time 3"
elif which wget >/dev/null 2>&1; then
    DL_CMD="wget -q -O"
    DL_TIMEOUT="-T 3"
else
    echo "Ошибка: wget или curl не найдены"
    exit 1
fi

mirror_url() {
    printf '%s/%s?h=%s' "$MIRROR_URL" "$1" "$BRANCH"
}

download_url() {
    # Третий аргумент нужен для curl --resolve. wget его не получает:
    # старые сборки wget на роутерах не поддерживают аналогичный режим.
    extra_args="${3:-}"
    if which curl >/dev/null 2>&1; then
        curl -sS -L -o "$1" $DL_TIMEOUT $extra_args "$2" 2>/dev/null
        return $?
    fi
    wget -q -O "$1" $DL_TIMEOUT "$2" 2>/dev/null
}

api_url() {
    if [ -n "$1" ]; then
        printf '%s/%s?ref=%s' "$API_BASE_URL" "$1" "$BRANCH"
    else
        printf '%s?ref=%s' "$API_BASE_URL" "$BRANCH"
    fi
}

sha_cache_key() {
    printf '%s' "$1" | tr '/ ' '__'
}

get_cached_sha() {
    key=$(sha_cache_key "$1")
    [ -f "${SHA_CACHE_DIR}/${key}" ] && sed -n '1p' "${SHA_CACHE_DIR}/${key}"
}

set_cached_sha() {
    rel="$1"
    sha="$2"
    [ -z "$sha" ] && return 0
    mkdir -p "$SHA_CACHE_DIR"
    key=$(sha_cache_key "$rel")
    printf '%s\n' "$sha" > "${SHA_CACHE_DIR}/${key}"
}

file_git_blob_sha() {
    file="$1"
    which sha1sum >/dev/null 2>&1 || return 1
    [ -f "$file" ] || return 1
    size=$(wc -c < "$file" 2>/dev/null | tr -d ' ')
    [ -n "$size" ] || return 1
    (printf 'blob %s\0' "$size"; cat "$file") | sha1sum | awk '{print $1}'
}

# Сверяет скачанный файл с SHA из манифеста GitHub: ловит битые/HTML-ответы.
# Без известного SHA или без sha1sum проверка пропускается.
verify_downloaded_sha() {
    file="$1"
    expected_sha="$2"
    [ -n "$expected_sha" ] || return 0
    which sha1sum >/dev/null 2>&1 || return 0
    actual_sha=$(file_git_blob_sha "$file")
    [ -n "$actual_sha" ] || return 0
    [ "$actual_sha" = "$expected_sha" ] && return 0
    echo "⚠ Контрольная сумма не совпала: $file"
    return 1
}

# Пригодный к запуску sh-файл: не пустой и начинается с shebang.
valid_script_file() {
    [ -s "$1" ] || return 1
    head -n 1 "$1" 2>/dev/null | grep -q '^#!'
}

json_sha_by_name() {
    json_file="$1"
    wanted_name="$2"
    awk -v wanted="$wanted_name" '
        /"name"[[:space:]]*:/ {
            name=$0
            sub(/^.*"name"[[:space:]]*:[[:space:]]*"/, "", name)
            sub(/".*$/, "", name)
            hit=(name == wanted)
        }
        hit && /"sha"[[:space:]]*:/ {
            sha=$0
            sub(/^.*"sha"[[:space:]]*:[[:space:]]*"/, "", sha)
            sub(/".*$/, "", sha)
            print sha
            exit
        }
    ' "$json_file" 2>/dev/null
}

check_local_dns() {
    which curl >/dev/null 2>&1 || return 1
    
    echo "Проверка локального DNS для raw.githubusercontent.com..."
    
    nslookup_output=$(nslookup raw.githubusercontent.com 2>/dev/null || true)

    local_ips=$(echo "$nslookup_output" | grep -iE 'Address[[:space:]]*([0-9]+)?:' | grep -v 'Server:' | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | grep -v '^127\.' || true)
    
    local_ips=$(echo "$local_ips" | sort -u | tr '\n' ' ')
    
    if [ -z "$local_ips" ]; then
        echo "Локальный DNS не вернул IP адресов."
        return 1
    fi
    
    ip_count=$(echo "$local_ips" | wc -w | tr -d ' ')
    
    echo "Локальный DNS вернул $ip_count адрес(ов): $local_ips"
    

    if [ "$ip_count" = "1" ]; then
        single_ip=$(echo "$local_ips" | tr -d ' ')
        echo "Обнаружен единственный IP: $single_ip. Проверяю доступность..."
        
        if curl -sS --connect-timeout 5 -m 8 -o /dev/null --resolve "raw.githubusercontent.com:443:$single_ip" "https://raw.githubusercontent.com/" >/dev/null 2>&1; then
    
            RAW_DL_EXTRA_ARGS="--resolve raw.githubusercontent.com:443:$single_ip --resolve raw.githubusercontent.com:80:$single_ip"
            echo "✓ raw.githubusercontent.com доступен через локальный DNS (IP: $single_ip)"
            return 0
        else
            echo "IP $single_ip недоступен через curl --resolve"
            return 1
        fi
    fi
    
    echo "Несколько IP адресов, требуется проверка через Google DoH"
    return 1
}

# Скачивает и запускает скрипт gh_fix.sh для исправления проблем с GitHub
# Параметры: $1 - рабочий IP, $2 - количество рабочих адресов, $3 - общее количество адресов
run_gh_fix() {
    which bash >/dev/null 2>&1 || {
        echo "Ошибка: bash не найден. Скрипт gh_fix.sh требует bash."
        return 1
    }
    
    local gh_fix_url="https://raw.githubusercontent.com/MarkinAlexander/custom-scripts/main/gh_fix.sh"
    local gh_fix_tmp="/tmp/gh_fix_$$"
    local working_ip="$1"
    local good_count="$2"
    local total_count="$3"
    
    echo ""
    echo "⚠ Обнаружены проблемы с доступностью raw.githubusercontent.com"
    echo "  Доступно $good_count из $total_count адресов"
    echo ""
    echo "Есть решение: скрипт gh_fix.sh может исправить ситуацию"
    echo "  - Скачает и предложит выбрать рабочие зеркала GitHub"
    echo "  - На Keenetic: настроит DNS через CLI"
    echo "  - На Linux/OpenWrt: пропишет в /etc/hosts"
    echo ""
    echo "Введите 1 для скачивания и запуска gh_fix.sh"
    echo "Введите 0 для пропуска и продолжения с текущими настройками"
    echo ""
    printf "Ваш выбор: "
    
    read -r choice < /dev/tty 2>/dev/null || choice=""
    
    if [ "$choice" = "0" ] || [ -z "$choice" ]; then
        echo "Пропускаю gh_fix.sh, продолжаю работу..."
        return 0
    fi
    
    if [ "$choice" != "1" ]; then
        echo "Неверный выбор. Пропускаю gh_fix.sh, продолжаю работу..."
        return 0
    fi
    
    echo ""
    echo "Скачиваю gh_fix.sh..."
    
    # Скачиваем используя рабочий IP
    local resolve_args=""
    if [ -n "$working_ip" ]; then
        resolve_args="--resolve raw.githubusercontent.com:443:$working_ip --resolve raw.githubusercontent.com:80:$working_ip"
    fi
    
    if curl -sS -L -o "$gh_fix_tmp" --max-time 30 $resolve_args "$gh_fix_url" 2>/dev/null; then
        chmod +x "$gh_fix_tmp"
        echo "✓ Скрипт скачан, запускаю..."
        echo ""
        bash "$gh_fix_tmp" < /dev/tty
        local exit_code=$?
        rm -f "$gh_fix_tmp"
        echo ""
        if [ $exit_code -eq 0 ]; then
            echo "✓ Скрипт gh_fix.sh завершен успешно"
            echo "  После изменения настроек может потребоваться перезапуск скрипта"
        else
            echo "⚠ Скрипт gh_fix.sh завершился с кодом $exit_code"
        fi
        return 0
    else
        echo "✗ Не удалось скачать gh_fix.sh"
        rm -f "$gh_fix_tmp"
        return 1
    fi
}

# Проверяем IP raw.githubusercontent.com через DoH и выбираем первый доступный.
# Важно: проверка идет через curl --resolve к исходному hostname, поэтому
# сертификат проверяется как обычно. -k/--insecure здесь намеренно не нужен.
prepare_raw_github_resolve() {
    doh_response=""
    all_ips=""
    ip=""
    tmp_good="/tmp/z2r_raw_good_ips_$$"
    probe_url="https://raw.githubusercontent.com/"

    [ -z "$RAW_DL_EXTRA_ARGS" ] || return 0
    which curl >/dev/null 2>&1 || return 0

    echo "Проверка доступности raw.githubusercontent.com через Google DoH..."
    doh_response=$(curl -fsSL --max-time 5 "https://dns.google/resolve?name=raw.githubusercontent.com&type=A" 2>/dev/null || true)
    all_ips=$(echo "$doh_response" | grep -oE '"data":[[:space:]]*"([0-9]{1,3}\.){3}[0-9]{1,3}"' | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' || true)

    if [ -z "$all_ips" ]; then
        echo "Не удалось получить IP через DoH. Использую стандартный DNS."
        return 0
    fi

    # Проверяем IP параллельно, чтобы не задерживать запуск на плохих адресах.
    rm -f "$tmp_good"
    for ip in $all_ips; do
        (
            if curl -sS --connect-timeout 5 -m 8 -o /dev/null --resolve "raw.githubusercontent.com:443:$ip" "$probe_url" >/dev/null 2>&1; then
                echo "$ip" >> "$tmp_good"
            fi
        ) &
    done
    wait


    total_count=$(echo "$all_ips" | wc -w | tr -d ' ')
    if [ -f "$tmp_good" ]; then
        good_count=$(wc -l < "$tmp_good" | tr -d ' ')
    else
        good_count=0
    fi
    ip=$(sed -n '1p' "$tmp_good" 2>/dev/null || true)
    rm -f "$tmp_good"

    if [ "$good_count" -eq "$total_count" ] && [ "$good_count" -gt 0 ]; then
        echo "✓ Все $good_count адрес(ов) raw.githubusercontent.com доступны через Google DoH"
    elif [ -n "$ip" ]; then
        RAW_DL_EXTRA_ARGS="--resolve raw.githubusercontent.com:443:$ip --resolve raw.githubusercontent.com:80:$ip"
        echo "raw.githubusercontent.com: доступно $good_count из $total_count адресов, использую IP $ip"
        
        # Предлагаем запустить gh_fix.sh если не все адреса рабочие
        if [ "$good_count" -lt "$total_count" ]; then
            run_gh_fix "$ip" "$good_count" "$total_count"
        fi
    else
        echo "Не найден доступный IP raw.githubusercontent.com. При ошибке загрузки будет использовано зеркало."
    fi
}

download_project_file() {
    dest="$1"
    rel="$2"
    remote_sha="$3"
    tmp="${STAGE_DIR}/tmp/$(sha_cache_key "$rel").$$"
    stage_dest="${STAGE_DIR}/files/${dest#/}"
    stage_meta="${STAGE_DIR}/meta/$(sha_cache_key "$rel")"

    if [ -n "$remote_sha" ] && [ -f "$dest" ]; then
        cached_sha=$(get_cached_sha "$rel")
        if [ "$cached_sha" = "$remote_sha" ]; then
            echo "Без изменений: $rel"
            return 0
        fi
        local_sha=$(file_git_blob_sha "$dest")
        if [ "$local_sha" = "$remote_sha" ]; then
            set_cached_sha "$rel" "$remote_sha"
            echo "Без изменений: $rel"
            return 0
        fi
    fi

    mkdir -p "$STAGE_DIR/tmp" "$(dirname "$stage_dest")" "$STAGE_DIR/meta"
    rm -f "$tmp"
    # Для GitHub raw передаем RAW_DL_EXTRA_ARGS, если DoH-проверка нашла рабочий IP.
    if download_url "$tmp" "$RAW_URL/$rel" "$RAW_DL_EXTRA_ARGS" && verify_downloaded_sha "$tmp" "$remote_sha"; then
        if [ -f "$dest" ] && cmp "$dest" "$tmp" >/dev/null 2>&1; then
            rm -f "$tmp"
            set_cached_sha "$rel" "$remote_sha"
        else
            mv -f "$tmp" "$stage_dest"
            {
                printf '%s\n' "$dest"
                printf '%s\n' "$rel"
                printf '%s\n' "$remote_sha"
            } > "$stage_meta"
        fi
        return 0
    fi
    rm -f "$tmp"
    # Для зеркала --resolve raw.githubusercontent.com не нужен.
    if [ -n "$MIRROR_URL" ]; then
        echo "GitHub недоступен для $rel. Пробую зеркало..."
        if download_url "$tmp" "$(mirror_url "$rel")" "" && verify_downloaded_sha "$tmp" "$remote_sha"; then
            if [ -f "$dest" ] && cmp "$dest" "$tmp" >/dev/null 2>&1; then
                rm -f "$tmp"
            else
                mv -f "$tmp" "$stage_dest"
                {
                    printf '%s\n' "$dest"
                    printf '%s\n' "$rel"
                    printf '%s\n' ""
                } > "$stage_meta"
            fi
            return 0
        fi
    fi
    rm -f "$tmp"
    echo "Не удалось скачать $rel"
    return 1
}

apply_staged_updates() {
    [ -d "$STAGE_DIR/meta" ] || return 0

    for stage_meta in "$STAGE_DIR"/meta/*; do
        [ -f "$stage_meta" ] || continue
        dest=$(sed -n '1p' "$stage_meta")
        rel=$(sed -n '2p' "$stage_meta")
        remote_sha=$(sed -n '3p' "$stage_meta")
        stage_dest="${STAGE_DIR}/files/${dest#/}"

        [ -f "$stage_dest" ] || return 1
        mkdir -p "$(dirname "$dest")"
        mv -f "$stage_dest" "$dest" || return 1
        set_cached_sha "$rel" "$remote_sha"
    done

    return 0
}

download_installer() {
    if download_url "$1" "$INSTALLER_URL" "$RAW_DL_EXTRA_ARGS" && valid_script_file "$1"; then
        return 0
    fi
    [ -n "$INSTALLER_MIRROR_URL" ] || return 1
    echo "GitHub недоступен для установщика. Пробую зеркало..."
    download_url "$1" "$INSTALLER_MIRROR_URL" "" && valid_script_file "$1"
}

# --- Развёртывание из tar-релизов ---

free_kb() {
    df -Pk "$1" 2>/dev/null | awk 'NR==2 {print $4}'
}

read_env_value() {
    [ -f "$1" ] || return 1
    env_line=$(grep "^$2=" "$1" 2>/dev/null | head -n 1)
    env_line=${env_line#*=}
    env_line=${env_line#\"}
    printf '%s' "${env_line%\"}"
}

zator_installed() {
    [ -f "$ZATOR_ROOT/z2r_lib/config.sh" ] || [ -f "$DEPLOY_VERSION_FILE" ]
}

webui_installed() {
    [ -e "$ZATOR_ROOT/webui/run-webui.sh" ]
}

fetch_url() {
    # $1 dest, $2 url, $3 таймаут (сек); пиннинг raw-хоста тут не нужен
    if which curl >/dev/null 2>&1; then
        curl -fsS -L -o "$1" --max-time "${3:-60}" "$2" 2>/dev/null
        return $?
    fi
    wget -q -O "$1" -T "${3:-60}" "$2" 2>/dev/null
}

latest_json_str() {
    sed -n "s/^.*\"$1\": *\"\([^\"]*\)\".*$/\1/p" "$LATEST_JSON" 2>/dev/null | head -n 1
}

latest_asset_field() {
    # $1 вариант (core|webui|full), $2 поле ассета (size|sha256|unpackedSize)
    awk -v v="\"$1\":" 'index($0, v) > 0 { inb = 1; next } inb && index($0, "}") > 0 { exit } inb { print }' "$LATEST_JSON" 2>/dev/null \
        | sed -n "s/^.*\"$2\": *\"\([^\"]*\)\".*$/\1/p" | head -n 1
    awk -v v="\"$1\":" 'index($0, v) > 0 { inb = 1; next } inb && index($0, "}") > 0 { exit } inb { print }' "$LATEST_JSON" 2>/dev/null \
        | sed -n "s/^.*\"$2\": *\([0-9][0-9]*\).*$/\1/p" | head -n 1
}

write_latest_env() {
    # файл-флаг для меню z2r и Web-панели: какая сборка на сервере
    mkdir -p "$ZATOR_ROOT/extra_strats/cache/deploy" 2>/dev/null || return 0
    latest_env="$ZATOR_ROOT/extra_strats/cache/deploy/latest.env"
    {
        printf 'LATEST_RELEASE="%s"\n' "$(latest_json_str release)"
        printf 'LATEST_BUILD_DATE="%s"\n' "$(latest_json_str buildDate)"
        printf 'LATEST_ZATOR_DATE="%s"\n' "$(latest_json_str zatorDate)"
        printf 'LATEST_WEBUI_DATE="%s"\n' "$(latest_json_str webuiDate)"
        printf 'LATEST_ZATOR_SHA="%s"\n' "$(latest_json_str zatorSha)"
        printf 'LATEST_WEBUI_SHA="%s"\n' "$(latest_json_str webuiSha)"
        printf 'LATEST_CHECKED_AT="%s"\n' "$(date -u '+%Y-%m-%d %H:%M' 2>/dev/null)"
    } > "${latest_env}.tmp.$$" 2>/dev/null && mv -f "${latest_env}.tmp.$$" "$latest_env" 2>/dev/null
    return 0
}

check_updates() {
    UPDATE_ZATOR=0
    UPDATE_WEBUI=0
    rm -f "$LATEST_JSON"
    if ! fetch_url "$LATEST_JSON" "$RELEASES_BASE/latest/latest.json" 20; then
        echo "⚠ Не достучались до сервера обновлений."
        return 1
    fi
    lz_sha=$(latest_json_str zatorSha)
    lw_sha=$(latest_json_str webuiSha)
    z_sha=$(read_env_value "$DEPLOY_VERSION_FILE" ZATOR_SHA)
    w_sha=$(read_env_value "$DEPLOY_VERSION_FILE" WEBUI_SHA)
    [ -n "$z_sha" ] && [ -n "$lz_sha" ] && [ "$z_sha" != "$lz_sha" ] && UPDATE_ZATOR=1
    [ -n "$w_sha" ] && [ -n "$lw_sha" ] && [ "$w_sha" != "$lw_sha" ] && UPDATE_WEBUI=1
    write_latest_env
    if [ "$UPDATE_ZATOR" = 1 ] || [ "$UPDATE_WEBUI" = 1 ]; then
        update_note="⬆ Есть обновление:"
        [ "$UPDATE_ZATOR" = 1 ] && update_note="$update_note zator от $(latest_json_str zatorDate)"
        [ "$UPDATE_WEBUI" = 1 ] && update_note="$update_note, Web-панель от $(latest_json_str webuiDate)"
        echo "$update_note"
    else
        echo "✓ Обновлений нет (релиз $(latest_json_str release))."
    fi
    return 0
}

ensure_space() {
    # $1 размер архива КБ, $2 развёрнутый объём КБ; выбирает DEPLOY_MODE=A|B|C
    DEPLOY_MODE=A
    sp_tmp=$(free_kb /tmp)
    sp_opt=$(free_kb "$INSTALL_DIR")
    if [ -z "$sp_tmp" ] || [ -z "$sp_opt" ]; then
        echo "⚠ Не удалось определить свободное место (df), проверки пропущены"
        return 0
    fi
    sp_need=$(( $2 + ZAPRET2_MARGIN_KB + DEPLOY_SLACK_KB ))
    if [ "$sp_opt" -lt "$sp_need" ]; then
        echo "✗ Недостаточно места на разделе /opt: свободно $((sp_opt / 1024)) МБ, нужно около $((sp_need / 1024)) МБ (zator + zapret2 + рост листов)."
        return 1
    fi
    if [ "$sp_tmp" -ge $(( $1 + $2 + 512 )) ]; then
        DEPLOY_MODE=A
    elif [ "$sp_opt" -ge $(( $1 + $2 + ZAPRET2_MARGIN_KB + DEPLOY_SLACK_KB )) ]; then
        echo "ℹ Мало места в /tmp — staging будет на /opt"
        DEPLOY_MODE=B
    else
        echo "ℹ Совсем мало места — установка без хранения архива"
        DEPLOY_MODE=C
    fi
    return 0
}

verify_archive() {
    # $1 файл, $2 ожидаемый sha256 (может быть пустым)
    va_magic=$(head -c 2 "$1" 2>/dev/null | od -b 2>/dev/null | tr -s ' \t' ' ' | head -n 1)
    case "$va_magic" in
        *037*213*) ;;
        *) echo "✗ Файл не является gzip-архивом: $1"; return 1 ;;
    esac
    gzip -t "$1" 2>/dev/null || { echo "✗ Архив повреждён (gzip -t): $1"; return 1; }
    if [ -n "$2" ] && which sha256sum >/dev/null 2>&1; then
        va_actual=$(sha256sum "$1" 2>/dev/null | awk '{print $1}')
        [ "$va_actual" = "$2" ] || { echo "✗ Контрольная сумма архива не совпала"; return 1; }
    fi
    return 0
}

verify_staging_manifest() {
    vsm_manifest="$1/extra_strats/cache/deploy/manifest.tsv"
    [ -f "$vsm_manifest" ] || { echo "✗ В архиве нет манифеста — отказ разворачивать"; return 1; }
    which sha256sum >/dev/null 2>&1 || { echo "⚠ sha256sum недоступен — сверка пропущена"; return 0; }
    vsm_bad=0
    while IFS='|' read -r vsm_path vsm_dest vsm_cls vsm_sha vsm_size vsm_exec; do
        case "$vsm_path" in ""|'#'*) continue ;; esac
        vsm_actual=$(sha256sum "$1/$vsm_path" 2>/dev/null | awk '{print $1}')
        if [ "$vsm_actual" != "$vsm_sha" ]; then
            echo "✗ Повреждён файл в архиве: $vsm_path"
            vsm_bad=$((vsm_bad + 1))
        fi
    done < "$vsm_manifest"
    [ "$vsm_bad" -eq 0 ] || { echo "✗ Сверка не пройдена ($vsm_bad файлов)"; return 1; }
    echo "✓ Сверка архива пройдена"
    return 0
}

staging_variant_name() {
    if [ -f "$1/_root/z2r.sh" ] || [ -d "$1/z2r_lib" ]; then
        if [ -e "$1/webui/run-webui.sh" ]; then printf full; else printf core; fi
    else
        printf webui
    fi
}

merge_version_env() {
    # $1 staging, $2 tracking (пусто = оставить прежний)
    mve_src="$1/extra_strats/cache/deploy/version.env"
    [ -f "$mve_src" ] || return 0
    mkdir -p "$ZATOR_ROOT/extra_strats/cache/deploy"
    if [ -f "$DEPLOY_VERSION_FILE" ] && [ "$(staging_variant_name "$1")" = "webui" ]; then
        # webui-only: заменяем только поля Web-панели
        mve_wver=$(read_env_value "$mve_src" WEBUI_VERSION)
        mve_wdate=$(read_env_value "$mve_src" WEBUI_DATE)
        mve_wsha=$(read_env_value "$mve_src" WEBUI_SHA)
        cp -f "$DEPLOY_VERSION_FILE" "$DEPLOY_VERSION_FILE.tmp.$$" || return 0
        sed -i "s/^WEBUI_VERSION=.*/WEBUI_VERSION=\"$mve_wver\"/; s/^WEBUI_DATE=.*/WEBUI_DATE=\"$mve_wdate\"/; s/^WEBUI_SHA=.*/WEBUI_SHA=\"$mve_wsha\"/" "$DEPLOY_VERSION_FILE.tmp.$$"
        mv -f "$DEPLOY_VERSION_FILE.tmp.$$" "$DEPLOY_VERSION_FILE"
    else
        cp -f "$mve_src" "$DEPLOY_VERSION_FILE.tmp.$$" && mv -f "$DEPLOY_VERSION_FILE.tmp.$$" "$DEPLOY_VERSION_FILE"
    fi
    [ -z "$2" ] || sed -i "s/^TRACKING=.*/TRACKING=\"$2\"/" "$DEPLOY_VERSION_FILE" 2>/dev/null
    return 0
}

install_manifest_files() {
    # $1 staging с распакованным архивом, $2 tracking
    imf_manifest="$1/extra_strats/cache/deploy/manifest.tsv"
    imf_name=$(staging_variant_name "$1")
    imf_installed=0
    imf_kept=0
    imf_z2r=0
    imf_webui=0
    while IFS='|' read -r imf_path imf_dest imf_cls imf_sha imf_size imf_exec; do
        case "$imf_path" in ""|'#'*) continue ;; esac
        case "$imf_dest" in
            /opt/z2r.sh) imf_dest="$INSTALL_DIR/z2r.sh" ;;
            /opt/zator/*) imf_dest="$ZATOR_ROOT/${imf_dest#/opt/zator/}" ;;
        esac
        if [ "$imf_cls" = "keep-if-exists" ] && [ -e "$imf_dest" ]; then
            imf_kept=$((imf_kept + 1))
            continue
        fi
        mkdir -p "$(dirname "$imf_dest")" 2>/dev/null
        rm -f "$imf_dest.tmp.$$"
        if ! cp "$1/$imf_path" "$imf_dest.tmp.$$"; then
            echo "✗ Не удалось установить $imf_dest"
            return 1
        fi
        mv -f "$imf_dest.tmp.$$" "$imf_dest" || return 1
        if [ "$imf_exec" = "1" ]; then chmod 755 "$imf_dest" 2>/dev/null; else chmod 644 "$imf_dest" 2>/dev/null; fi
        [ "$imf_dest" = "$INSTALL_DIR/z2r.sh" ] && imf_z2r=1
        case "$imf_dest" in "$ZATOR_ROOT"/webui/*) imf_webui=1 ;; esac
        imf_installed=$((imf_installed + 1))
    done < "$imf_manifest"
    if [ -d "$ZATOR_ROOT/webui/www" ]; then
        [ -L "$ZATOR_ROOT/webui/www/cgi-bin" ] || ln -sfn ../cgi-bin "$ZATOR_ROOT/webui/www/cgi-bin" 2>/dev/null
    fi
    if [ "$imf_webui" = 1 ] && [ -x /opt/bin/bash ]; then
        sed -i "1s|^#!.*bash\$|#!/opt/bin/bash|" "$ZATOR_ROOT/webui/run-webui.sh" "$ZATOR_ROOT"/webui/cgi-bin/* 2>/dev/null
    fi
    if [ "$imf_webui" = 1 ] && [ -x "$ZATOR_ROOT/webui/run-webui.sh" ]; then
        imf_stat=$("$ZATOR_ROOT/webui/run-webui.sh" status 2>/dev/null)
        case "$imf_stat" in
            running:*) "$ZATOR_ROOT/webui/run-webui.sh" restart >/dev/null 2>&1 && echo "✓ Web-панель перезапущена" ;;
        esac
    fi
    merge_version_env "$1" "$2"
    # раздельные манифесты по компонентам, как в lib/deploy.sh
    if [ -f "$1/_root/z2r.sh" ] || [ -d "$1/z2r_lib" ]; then
        awk -F'|' '$1 ~ /^#/ || $1 !~ /^webui\// {print}' "$imf_manifest" > "$ZATOR_ROOT/extra_strats/cache/deploy/manifest.core.tsv"
    fi
    if [ -e "$1/webui/run-webui.sh" ]; then
        awk -F'|' '$1 ~ /^#/ || $1 ~ /^webui\// {print}' "$imf_manifest" > "$ZATOR_ROOT/extra_strats/cache/deploy/manifest.webui.tsv"
    fi
    rm -f "$ZATOR_ROOT/extra_strats/cache/deploy/manifest.full.tsv" "$ZATOR_ROOT/extra_strats/cache/deploy/manifest.full.json" 2>/dev/null
    [ -f "$1/extra_strats/cache/deploy/manifest.json" ] && cp -f "$1/extra_strats/cache/deploy/manifest.json" "$ZATOR_ROOT/extra_strats/cache/deploy/manifest.$imf_name.json" 2>/dev/null
    echo "✓ Установлено файлов: $imf_installed, сохранено пользовательских: $imf_kept"
    [ "$imf_z2r" = 1 ] && echo "⚠ z2r.sh обновлён — перезапустите меню"
    return 0
}

deploy_minimal() {
    # $1 файл архива, $2 tracking; использует DEPLOY_MODE из ensure_space
    dm_stage="/tmp/z2r_tar_stage_$$"
    [ "$DEPLOY_MODE" = "B" ] && dm_stage="$ZATOR_ROOT/.deploy-staging.$$"
    rm -rf "$dm_stage"
    mkdir -p "$dm_stage" || return 1
    if ! tar -xzf "$1" -C "$dm_stage" 2>/dev/null; then
        rm -rf "$dm_stage"
        echo "✗ Не удалось распаковать архив"
        return 1
    fi
    if ! verify_staging_manifest "$dm_stage"; then
        rm -rf "$dm_stage"
        return 1
    fi
    if ! install_manifest_files "$dm_stage" "$2"; then
        rm -rf "$dm_stage"
        return 1
    fi
    rm -rf "$dm_stage"
    return 0
}

fresh_stream_install() {
    # $1 вариант; свежая установка без хранения архива на диске (режим C)
    fsi_new="$ZATOR_ROOT.deploy.new.$$"
    rm -rf "$fsi_new"
    mkdir -p "$fsi_new" || return 1
    echo "Скачиваю потоково zator-$1.tar.gz..."
    if which curl >/dev/null 2>&1; then
        curl -sS -L --max-time 300 "$RELEASES_BASE/latest/zator-$1.tar.gz" 2>/dev/null | tar -xz -C "$fsi_new"
    else
        wget -q -O - -T 300 "$RELEASES_BASE/latest/zator-$1.tar.gz" 2>/dev/null | tar -xz -C "$fsi_new"
    fi
    if ! verify_staging_manifest "$fsi_new"; then
        rm -rf "$fsi_new"
        return 1
    fi
    mkdir -p "$INSTALL_DIR" 2>/dev/null
    if [ -f "$fsi_new/_root/z2r.sh" ]; then
        cp "$fsi_new/_root/z2r.sh" "$INSTALL_DIR/z2r.sh.tmp.$$" \
            && mv -f "$INSTALL_DIR/z2r.sh.tmp.$$" "$INSTALL_DIR/z2r.sh" \
            && chmod 755 "$INSTALL_DIR/z2r.sh"
        rm -rf "$fsi_new/_root"
    fi
    rm -rf "$ZATOR_ROOT"
    if ! mv -f "$fsi_new" "$ZATOR_ROOT"; then
        rm -rf "$fsi_new"
        return 1
    fi
    if [ -d "$ZATOR_ROOT/_payload" ]; then
        rm -rf "$ZATOR_ROOT/.deploy-payload"
        mv -f "$ZATOR_ROOT/_payload" "$ZATOR_ROOT/.deploy-payload"
    fi
    if [ -d "$ZATOR_ROOT/webui/www" ]; then
        [ -L "$ZATOR_ROOT/webui/www/cgi-bin" ] || ln -sfn ../cgi-bin "$ZATOR_ROOT/webui/www/cgi-bin" 2>/dev/null
    fi
    if [ -x /opt/bin/bash ] && [ -e "$ZATOR_ROOT/webui/run-webui.sh" ]; then
        sed -i "1s|^#!.*bash\$|#!/opt/bin/bash|" "$ZATOR_ROOT/webui/run-webui.sh" "$ZATOR_ROOT"/webui/cgi-bin/* 2>/dev/null
    fi
    echo "✓ zator установлен (потоково, без хранения архива)"
    return 0
}

have_deploy_sh() {
    [ -f "$ZATOR_ROOT/z2r_lib/deploy.sh" ] && which bash >/dev/null 2>&1
}

run_deploy_sh() {
    # $1 url архива, $2 вариант, $3 tag; вывод и проверки делает deploy.sh.
    # Корни обязательны в env: standalone deploy.sh иначе уходит в /opt по умолчанию.
    ZATOR_ROOT="$ZATOR_ROOT" \
    ZAPRET2_ROOT="${Z2R_ZAPRET2_ROOT:-/opt/zapret2}" \
    Z2R_SCRIPT_DEST="$INSTALL_DIR/z2r.sh" \
    Z2R_RELEASES_BASE="$RELEASES_BASE" \
        bash "$ZATOR_ROOT/z2r_lib/deploy.sh" from-tar "$1" "$2" "$3"
}

launcher_variant() {
    if [ -n "$DEPLOY_VARIANT_ARG" ]; then
        printf '%s' "$DEPLOY_VARIANT_ARG"
    elif [ -n "$DEPLOY_VARIANT" ]; then
        printf '%s' "$DEPLOY_VARIANT"
    elif webui_installed; then
        printf full
    else
        printf core
    fi
}

builtin_tar_deploy() {
    # $1 вариант, $2 tag; встроенный путь, когда lib/deploy.sh ещё не установлен
    btd_size=$(latest_asset_field "$1" size)
    btd_unpacked=$(latest_asset_field "$1" unpackedSize)
    if [ -z "$btd_size" ] || [ -z "$btd_unpacked" ]; then
        echo "✗ Нет данных о размерах архива в latest.json"
        return 1
    fi
    ensure_space $(( (btd_size + 1023) / 1024 )) $(( btd_unpacked / 1024 + 1 )) || return 1
    if [ "$DEPLOY_MODE" = "C" ]; then
        echo "✗ Слишком мало места для встроенного развёртывания, а lib/deploy.sh отсутствует"
        return 1
    fi
    btd_arch="/tmp/z2r_deploy_$$.tar.gz"
    echo "Скачиваю zator-$1.tar.gz (релиз $2, ~$(( (btd_size + 1048575) / 1048576 )) МБ)..."
    if ! fetch_url "$btd_arch" "$RELEASES_BASE/$2/zator-$1.tar.gz" 300; then
        rm -f "$btd_arch"
        return 1
    fi
    if ! verify_archive "$btd_arch" "$(latest_asset_field "$1" sha256)"; then
        rm -f "$btd_arch"
        return 1
    fi
    deploy_minimal "$btd_arch" ""
    btd_rc=$?
    rm -f "$btd_arch"
    return $btd_rc
}

deploy_version() {
    # $1 номер релиза: установка конкретной версии и закрепление (пин)
    echo "=== Установка релиза $1 ==="
    if have_deploy_sh; then
        if run_deploy_sh "$RELEASES_BASE/$1/zator-$(launcher_variant).tar.gz" "$(launcher_variant)" "$1"; then
            echo "ℹ Версия закреплена ($1): автообновление выключено, обновления вручную (z2r update или п.5 меню)."
            return 0
        fi
        echo "⚠ lib/deploy.sh не справился, пробую встроенный путь"
    fi
    rm -f "$LATEST_JSON"
    if ! fetch_url "$LATEST_JSON" "$RELEASES_BASE/$1/latest.json" 20; then
        echo "✗ Релиз $1 не найден."
        return 1
    fi
    if builtin_tar_deploy "$(launcher_variant)" "$1"; then
        sed -i "s/^TRACKING=.*/TRACKING=\"$1\"/" "$DEPLOY_VERSION_FILE" 2>/dev/null
        echo "ℹ Версия закреплена ($1): автообновление выключено, обновления вручную (z2r update или п.5 меню)."
        return 0
    fi
    return 1
}

deploy_local_tar() {
    # $1 путь к локальному архиву
    if [ ! -f "$1" ]; then
        echo "✗ Файл не найден: $1"
        return 1
    fi
    echo "=== Развёртывание из локального архива $1 ==="
    if have_deploy_sh; then
        run_deploy_sh "$1" "" ""
        return $?
    fi
    verify_archive "$1" "" || return 1
    dlt_unpacked=$(gzip -l "$1" 2>/dev/null | awk 'NR==2 {print $2}')
    ensure_space $(( ($(wc -c < "$1") + 1023) / 1024 )) $(( ${dlt_unpacked:-0} / 1024 + 1 )) || return 1
    [ "$DEPLOY_MODE" != "C" ] || { echo "✗ Слишком мало места для встроенного развёртывания, а lib/deploy.sh отсутствует"; return 1; }
    deploy_minimal "$1" ""
}

auto_tar_update() {
    # умный выбор варианта: устарел только webui и он установлен -> webui
    if [ -n "$DEPLOY_VARIANT_ARG" ]; then
        atu_variant="$DEPLOY_VARIANT_ARG"
    elif [ -n "$DEPLOY_VARIANT" ]; then
        atu_variant="$DEPLOY_VARIANT"
    elif [ "$UPDATE_ZATOR" = 1 ]; then
        webui_installed && atu_variant=full || atu_variant=core
    elif webui_installed; then
        atu_variant=webui
    else
        atu_variant=core
    fi
    echo "=== Обновление zator из релиза ($atu_variant) ==="
    if have_deploy_sh; then
        if run_deploy_sh "$RELEASES_BASE/latest/zator-$atu_variant.tar.gz" "$atu_variant" latest; then
            return 0
        fi
        echo "⚠ lib/deploy.sh не справился, пробую встроенный путь"
    fi
    builtin_tar_deploy "$atu_variant" latest
}

fresh_tar_install() {
    # rc: 0 — установлено, 1 — сбой (можно фолбэк на raw), 2 — нельзя ставить (место)
    echo "=== Установка zator с нуля ==="
    rm -f "$LATEST_JSON"
    if ! fetch_url "$LATEST_JSON" "$RELEASES_BASE/latest/latest.json" 20; then
        echo "⚠ Сервер релизов недоступен."
        return 1
    fi
    ftv_full=$(latest_asset_field full size)
    ftv_core=$(latest_asset_field core size)
    ftv_full_mb=$(( (ftv_full + 1048575) / 1048576 ))
    ftv_core_mb=$(( (ftv_core + 1048575) / 1048576 ))
    if [ -n "$DEPLOY_VARIANT_ARG" ]; then
        ftv_variant="$DEPLOY_VARIANT_ARG"
    elif [ -n "$DEPLOY_VARIANT" ]; then
        ftv_variant="$DEPLOY_VARIANT"
    else
        ftv_choice=2
        if [ -c /dev/tty ]; then
            echo ""
            echo "Установить Web-панель управления?"
            echo "  1 - да, с панелью (full, ~${ftv_full_mb} МБ)"
            echo "  2 - нет, только ядро (core, ~${ftv_core_mb} МБ)"
            printf "Ваш выбор [2]: "
            read -r ftv_choice < /dev/tty 2>/dev/null || ftv_choice=2
        else
            echo "ℹ Без терминала — ставлю core (Web-панель можно добавить позже: п.14 меню)"
        fi
        case "$ftv_choice" in
            1) ftv_variant=full ;;
            *) ftv_variant=core ;;
        esac
    fi
    ftv_size=$(latest_asset_field "$ftv_variant" size)
    ftv_unpacked=$(latest_asset_field "$ftv_variant" unpackedSize)
    [ -n "$ftv_size" ] || { echo "✗ Нет данных о размере архива."; return 1; }
    ensure_space $(( (ftv_size + 1023) / 1024 )) $(( ftv_unpacked / 1024 + 1 )) || return 2
    if [ "$DEPLOY_MODE" = "C" ]; then
        fresh_stream_install "$ftv_variant" && return 0
        return 1
    fi
    ftv_arch="/tmp/z2r_deploy_$$.tar.gz"
    echo "Скачиваю zator-$ftv_variant.tar.gz (~$(( (ftv_size + 1048575) / 1048576 )) МБ)..."
    if ! fetch_url "$ftv_arch" "$RELEASES_BASE/latest/zator-$ftv_variant.tar.gz" 300; then
        rm -f "$ftv_arch"
        return 1
    fi
    if ! verify_archive "$ftv_arch" "$(latest_asset_field "$ftv_variant" sha256)"; then
        rm -f "$ftv_arch"
        return 1
    fi
    deploy_minimal "$ftv_arch" "latest"
    ftv_rc=$?
    rm -f "$ftv_arch"
    return $ftv_rc
}

verify_repo_branch() {
    [ -n "$API_BASE_URL" ] || return 0
    which curl >/dev/null 2>&1 || return 0
    code=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 8 $RAW_DL_EXTRA_ARGS "$RAW_URL/z2r.sh" 2>/dev/null)
    case "$code" in
        200) return 0 ;;
        404)
            echo "Ошибка: репозиторий или ветка не найдены: $RAW_URL"
            echo "Укажите URL с существующей веткой или сбросьте настройки: z2r default"
            exit 1
            ;;
        *) echo "⚠ Не удалось проверить ветку $BRANCH, продолжаю" ;;
    esac
    return 0
}

# Попытка обеспечить наличие bash на разных платформах
ensure_bash() {
    if which bash >/dev/null 2>&1; then
        return 0
    fi

    echo "bash не найден, пробую установить..."

    # OpenWrt / Entware (Keenetic, Merlin)
    if which opkg >/dev/null 2>&1; then
        opkg update >/dev/null 2>&1 || true
        opkg install bash >/dev/null 2>&1 && return 0
    fi

    # OpenWrt 25
    if which apk >/dev/null 2>&1; then
        apk update >/dev/null 2>&1 || true
        apk add bash >/dev/null 2>&1 && return 0
    fi

    # Debian / Ubuntu
    if which apt-get >/dev/null 2>&1; then
        apt-get update -y >/dev/null 2>&1 || true
        apt-get install -y bash >/dev/null 2>&1 && return 0
    fi

    # Alpine
    if which apk >/dev/null 2>&1; then
        apk add --no-cache bash >/dev/null 2>&1 && return 0
    fi

    # RHEL/CentOS/Fedora
    if which dnf >/dev/null 2>&1; then
        dnf install -y bash >/dev/null 2>&1 && return 0
    fi
    if which yum >/dev/null 2>&1; then
        yum install -y bash >/dev/null 2>&1 && return 0
    fi

    # Arch
    if which pacman >/dev/null 2>&1; then
        pacman -Sy --noconfirm bash >/dev/null 2>&1 && return 0
    fi

    return 1
}

cleanup_update_temps() {
    rm -f "$TEMP_JSON" "$TEMP_ROOT_JSON" "$TEMP_ORCHESTRA_JSON" 2>/dev/null || true
    [ -n "$STAGE_DIR" ] && rm -rf "$STAGE_DIR" 2>/dev/null || true
}

run_old_z2r() {
    # Z2R_NO_EXEC=1 — тестовый хук: развернуть и выйти, не запуская z2r.sh
    if [ "${Z2R_NO_EXEC:-0}" = "1" ]; then
        echo "ℹ Z2R_NO_EXEC=1: запуск z2r.sh пропущен"
        exit 0
    fi
    echo "Запускаю старую версию z2r.sh..."
    cd "${INSTALL_DIR}" || exit 1

    if ensure_bash && which bash >/dev/null 2>&1; then
        SHELL_CMD="bash"
    elif which ash >/dev/null 2>&1; then
        SHELL_CMD="ash"
    else
        SHELL_CMD="sh"
    fi

    [ "$SHELL_CMD" != "bash" ] && echo "⚠ bash недоступен, запускаю через $SHELL_CMD"
    # Прокидываем источник проекта из z2r.conf: иначе z2r.sh качает свои файлы
    # (webui, config.default, lua, листы) из репозитория по умолчанию.
    export Z2R_BRANCH="$BRANCH"
    export Z2R_PROJECT_RAW_BASE="$RAW_URL"
    if [ -n "$MIRROR_URL" ]; then
        export Z2R_PROJECT_MIRROR_BASE="$MIRROR_URL"
    fi
    [ -t 0 ] && exec "$SHELL_CMD" ./z2r.sh "$@" || exec "$SHELL_CMD" ./z2r.sh "$@" < /dev/tty
}

abort_update_run_old() {
    echo "Обновление отменено: один или несколько файлов не удалось скачать."
    cleanup_update_temps
    if [ -f "${INSTALL_DIR}/z2r.sh" ]; then
        run_old_z2r "$@"
    fi
    echo "Старая версия ${INSTALL_DIR}/z2r.sh не найдена."
    exit 1
}

# Определение откуда запущен скрипт
if which readlink >/dev/null 2>&1; then
    SCRIPT_PATH=$(readlink -f "$0" 2>/dev/null || echo "$0")
elif which realpath >/dev/null 2>&1; then
    SCRIPT_PATH=$(realpath "$0" 2>/dev/null || echo "$0")
else
    SCRIPT_PATH="$0"
fi

# Сначала проверяем локальный DNS. Если он возвращает один рабочий IP,
# используем его и пропускаем Google DoH проверку.
if ! check_local_dns; then
    prepare_raw_github_resolve
fi

if [ "$URL_ARGS_GIVEN" -eq 1 ]; then
    verify_repo_branch
    save_conf
    echo "✓ Сохранено в $Z2R_CONF, сброс: z2r default"
fi

# Если запущен из установленной команды - проверяем обновления
if [ "$SCRIPT_PATH" = "$BIN_PATH" ]; then
    echo "Проверка обновлений установщика..."
    TEMP_INSTALLER="/tmp/z2r_inst_$$"

    if download_installer "$TEMP_INSTALLER"; then
        if ! cmp "$SCRIPT_PATH" "$TEMP_INSTALLER" >/dev/null 2>&1; then
            echo "✓ Найдено обновление установщика"
            if cp "$TEMP_INSTALLER" "$BIN_PATH" && chmod +x "$BIN_PATH"; then
                rm -f "$TEMP_INSTALLER"
                echo "✓ Установщик обновлен, перезапуск..."
                echo ""
                exec "$BIN_PATH" "$@"
            fi
            echo "⚠ Не удалось заменить установщик, продолжаю текущий"
        fi
        rm -f "$TEMP_INSTALLER"
    fi
else
    # Первый запуск - установка
    echo "Установка команды z2r в $BIN_PATH..."

    if [ -f "$SCRIPT_PATH" ] && mv "$SCRIPT_PATH" "$BIN_PATH" 2>/dev/null; then
        :
    else
        cp "$SCRIPT_PATH" "$BIN_PATH" 2>/dev/null || echo "⚠ Не удалось установить команду z2r в $BIN_PATH"
    fi

    if [ -f "$BIN_PATH" ]; then
        chmod +x "$BIN_PATH" && echo "✓ Команда z2r установлена"
    fi
    echo ""
fi

# --- Главное дерево развёртывания ---
# Основной путь — tar-релизы; raw-пофайловый остаётся резервом (сбой сети/релизов,
# -raw-update, староверы). Порядок: локальный файл > пин-версия > свежая установка >
# проверка/автообновление.
TAR_FLOW_DONE=0
TAR_FLOW_SKIP=0
if [ "$RAW_UPDATE" = 1 ]; then
    echo "ℹ Режим -raw-update: пофайловое обновление из ветки $BRANCH"
elif [ -n "$LOCAL_TAR" ]; then
    deploy_local_tar "$LOCAL_TAR" && TAR_FLOW_DONE=1
elif [ -n "$DEPLOY_VERSION_ARG" ]; then
    deploy_version "$DEPLOY_VERSION_ARG" && TAR_FLOW_DONE=1
elif ! zator_installed; then
    fresh_tar_install
    case $? in
        0) TAR_FLOW_DONE=1 ;;
        2) exit 1 ;;
    esac
elif check_updates; then
    # сервер доступен: независимо от вердикта raw-фолбэк не нужен
    TRACKING_NOW=$(read_env_value "$DEPLOY_VERSION_FILE" TRACKING)
    if [ "$CMD_CHECK" = 1 ]; then
        : # только проверка, ничего не качаем
    elif [ "$NO_UPDATE" = 1 ]; then
        : # уведомление уже напечатано check_updates
    elif [ "$CMD_UPDATE" = 1 ]; then
        auto_tar_update && TAR_FLOW_DONE=1
    elif [ "$AUTOUPDATE" = "off" ]; then
        echo "ℹ Автообновление выключено (AUTOUPDATE=off в $Z2R_CONF). Ручное: z2r update или п.5 меню."
    elif [ -n "$TRACKING_NOW" ] && [ "$TRACKING_NOW" != "latest" ]; then
        echo "ℹ Версия закреплена ($TRACKING_NOW), автообновление выключено. Ручное: z2r update или п.5 меню."
    elif [ "$UPDATE_ZATOR" = 1 ] || [ "$UPDATE_WEBUI" = 1 ]; then
        auto_tar_update && TAR_FLOW_DONE=1
    fi
    TAR_FLOW_SKIP=1
fi
rm -f "$LATEST_JSON" 2>/dev/null

if [ "$TAR_FLOW_DONE" = 1 ]; then
    echo ""
elif [ "$TAR_FLOW_SKIP" = 1 ] && [ -f "${INSTALL_DIR}/z2r.sh" ]; then
    :
elif { [ "$NO_UPDATE" = 1 ] || [ "$CMD_CHECK" = 1 ]; } && zator_installed && [ -f "${INSTALL_DIR}/z2r.sh" ]; then
    echo "ℹ Файлы zator не тронуты."
else

echo "=== Обновление zator ==="
mkdir -p "${INSTALL_DIR}/zator/z2r_lib"
mkdir -p "${INSTALL_DIR}/zator/extra_strats/cache/orchestra"
mkdir -p "${INSTALL_DIR}/zator/lua"
mkdir -p "$SHA_CACHE_DIR"

# Получаем легкие GitHub-манифесты с SHA, чтобы не качать неизменившиеся файлы
echo "Загрузка компонентов..."
TEMP_JSON="/tmp/z2r_json_$$"
TEMP_ROOT_JSON="/tmp/z2r_root_json_$$"
TEMP_ORCHESTRA_JSON="/tmp/z2r_orchestra_json_$$"
STAGE_DIR="/tmp/z2r_stage_$$"
rm -rf "$STAGE_DIR"
mkdir -p "$STAGE_DIR/tmp" "$STAGE_DIR/files" "$STAGE_DIR/meta" || abort_update_run_old "$@"

fetch_api_manifest() {
    if [ -z "$API_BASE_URL" ]; then
        echo "[]" > "$1"
        return 0
    fi
    $DL_CMD "$1" $DL_TIMEOUT "$(api_url "$2")" 2>/dev/null || echo "[]" > "$1"
}

fetch_api_manifest "$TEMP_JSON" "lib" &
API_PID=$!
fetch_api_manifest "$TEMP_ROOT_JSON" "" &
ROOT_API_PID=$!
fetch_api_manifest "$TEMP_ORCHESTRA_JSON" "orchestra" &
ORCHESTRA_API_PID=$!

wait "$API_PID"
wait "$ROOT_API_PID"
wait "$ORCHESTRA_API_PID"

# Парсинг JSON
LIB_FILES=$(grep '"name":' "$TEMP_JSON" 2>/dev/null | grep '\.sh"' | sed 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' | tr '\n' ' ')
if [ -z "$LIB_FILES" ]; then
    LIB_FILES="$LIB_FILES_FALLBACK"
fi
for required_file in $LIB_FILES_REQUIRED; do
    case " $LIB_FILES " in
        *" $required_file "*) ;;
        *) LIB_FILES="$LIB_FILES $required_file" ;;
    esac
done

# Загрузка z2r.sh и библиотек
echo "Загрузка библиотек..."

Z2R_SHA=$(json_sha_by_name "$TEMP_ROOT_JSON" "z2r.sh")
if ! download_project_file "${INSTALL_DIR}/z2r.sh" "z2r.sh" "$Z2R_SHA"; then
    echo "Ошибка: не удалось загрузить ${INSTALL_DIR}/z2r.sh"
    abort_update_run_old "$@"
fi

LIB_PIDS=""
LIB_JOB_COUNT=0
LIB_DOWNLOAD_FAILED=0
for file in $LIB_FILES; do
    file_sha=$(json_sha_by_name "$TEMP_JSON" "$file")
    {
        download_project_file "${INSTALL_DIR}/zator/z2r_lib/${file}" "lib/${file}" "$file_sha"
    } &
    LIB_PIDS="$LIB_PIDS $!"
    LIB_JOB_COUNT=$((LIB_JOB_COUNT + 1))
    if [ "$LIB_JOB_COUNT" -ge "$MAX_DOWNLOAD_JOBS" ]; then
        for pid in $LIB_PIDS; do
            wait "$pid" || LIB_DOWNLOAD_FAILED=1
        done
        LIB_PIDS=""
        LIB_JOB_COUNT=0
    fi
done

for pid in $LIB_PIDS; do
    wait "$pid" || LIB_DOWNLOAD_FAILED=1
done
if [ "$LIB_DOWNLOAD_FAILED" -ne 0 ]; then
    echo "Ошибка: не все библиотеки загружены."
    abort_update_run_old "$@"
fi

echo "✓ Компоненты загружены"
echo ""
# Оркестратор и locked.lua (ручной режим). Отсутствие не критично:
# z2r.sh при запуске сам докачает недостающие lua-модули.
ORCHESTRATOR_SHA=$(json_sha_by_name "$TEMP_ORCHESTRA_JSON" "orchestrator.sh")
LOCKED_SHA=$(json_sha_by_name "$TEMP_ORCHESTRA_JSON" "locked.lua")
download_project_file "${INSTALL_DIR}/zator/extra_strats/cache/orchestra/orchestrator.sh" "orchestra/orchestrator.sh" "$ORCHESTRATOR_SHA" || {
    echo "⚠ orchestrator.sh не загружен"
}
download_project_file "${INSTALL_DIR}/zator/lua/locked.lua" "orchestra/locked.lua" "$LOCKED_SHA" || {
    echo "⚠ locked.lua не загружен, z2r.sh скачает его при запуске"
}

if ! apply_staged_updates; then
    echo "Ошибка: не удалось применить загруженные файлы."
    abort_update_run_old "$@"
fi
[ -x "${INSTALL_DIR}/z2r.sh" ] || chmod +x "${INSTALL_DIR}/z2r.sh"
[ -x "${INSTALL_DIR}/zator/extra_strats/cache/orchestra/orchestrator.sh" ] || chmod +x "${INSTALL_DIR}/zator/extra_strats/cache/orchestra/orchestrator.sh" 2>/dev/null || true
cleanup_update_temps
echo "✓ Оркестратор и locked.lua загружены"
echo ""

fi

echo "=== Запуск z2r.sh ==="
run_old_z2r "$@"
